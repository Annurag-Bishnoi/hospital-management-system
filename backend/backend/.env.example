# Railway / Production Environment Variables
# These variables should be configured in your Railway project settings.
# The application uses these variables to connect to the database.
PORT=8081
MYSQL_URL=jdbc:mysql://your-railway-db-host:3306/hms_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQLUSER=root
MYSQLPASSWORD=your_db_password
